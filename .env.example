# ==============================================================================
# Patemon - Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production keys into version control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Makassar"
NEXT_PUBLIC_SUPPORT_WHATSAPP_PHONE="6281234567890"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Also accepts NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Server-only Secret Key. Never expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-secret-key"
# Also accepts SUPABASE_SECRET_KEY
SUPABASE_SECRET_KEY="your-service-role-or-secret-key"

# Midtrans Sandbox Configuration: copy keys exactly from the Sandbox dashboard.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
# Server-only key. Never expose MIDTRANS_SERVER_KEY to client code.
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
# Separate server-only secret for notification signatures.
MIDTRANS_SIGNATURE_SECRET_KEY="your-signature-secret-key"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
